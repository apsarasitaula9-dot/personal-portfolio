# Environment Variables for Contact Form (Vercel / Resend)
# Copy this file to .env.local for local development if testing locally.
# In Vercel, add these under Project Settings -> Environment Variables.

# REQUIRED: Your Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# OPTIONAL: The recipient email address where you want to receive inquiries.
# Defaults to apsarasitaula9@gmail.com if not specified.
TO_EMAIL=apsarasitaula9@gmail.com

# OPTIONAL: Sender address.
# By default, Resend provides 'Portfolio Contact <onboarding@resend.dev>' for free testing.
# NOTE: When using onboarding@resend.dev, Resend only allows sending to the email address
# that registered the Resend account.
# Once you verify a custom domain in Resend, you can change this to:
# FROM_EMAIL=Apsara Sitaula <hello@yourdomain.com>
FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
